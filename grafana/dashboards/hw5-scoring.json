{
  "uid": "hw5-scoring",
  "title": "Transaction Processing",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "title": "Transactions per Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(scoring_transactions_total[$__rate_interval]))",
          "legendFormat": "TPS",
          "format": "time_series",
          "editorMode": "code",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Processing Latency (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scoring_transaction_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "format": "time_series",
          "editorMode": "code",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Fraud Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(scoring_fraud_total[30s])) / sum(rate(scoring_transactions_total[30s]))",
          "legendFormat": "Fraud Rate",
          "format": "time_series",
          "editorMode": "code",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Score Distribution Over Time",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(scoring_score_bucket[15s]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "editorMode": "code",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "none"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Model Version Changes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "((time() - scoring_model_reload_timestamp_seconds) < 30) * 0 + 1",
          "legendFormat": "{{version}}",
          "format": "time_series",
          "editorMode": "code",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {},
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Fraud Rate by Category (Last 1,000 Transactions)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT cat_id AS \"Category\", 100 * avg(fraud_flag) AS \"Fraud Rate (%)\"\nFROM (\n    SELECT cat_id, fraud_flag\n    FROM transaction_scores\n    ORDER BY scored_at DESC, transaction_id DESC\n    LIMIT 1000\n) recent\nGROUP BY cat_id\nORDER BY 2 DESC",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "TPS by State and Merchant",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT date_bin('10 seconds', scored_at, '2000-01-01'::timestamptz) AS time,\n       count(*) / 10.0 AS \"TPS\"\nFROM transaction_scores\nWHERE $__timeFilter(scored_at)\n  AND us_state IN (${us_state:sqlstring})\n  AND merch IN (${merch:sqlstring})\nGROUP BY 1\nORDER BY 1",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Score Density by State and Merchant",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "rawSql": "WITH buckets AS (\n    SELECT least(floor(score * 10)::int, 9) AS bucket, count(*) AS scores\n    FROM transaction_scores\n    WHERE $__timeFilter(scored_at)\n  AND us_state IN (${us_state:sqlstring})\n  AND merch IN (${merch:sqlstring})\n    GROUP BY 1\n)\nSELECT concat(bucket / 10.0, ' - ', (bucket + 1) / 10.0) AS \"Score\",\n       10 * scores / sum(scores) OVER () AS \"Density\"\nFROM buckets\nORDER BY bucket",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {},
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "us_state",
        "label": "State",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres"
        },
        "query": "SELECT DISTINCT us_state FROM transaction_scores ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "merch",
        "label": "Merchant",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres"
        },
        "query": "SELECT DISTINCT merch FROM transaction_scores ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
